# Токен от @BotFather
BOT_TOKEN=123456:ABC...
# Твой Telegram ID (узнать: @userinfobot). Несколько — через запятую
ADMIN_IDS=111111111
# Кто ещё может входить в CRM командой /panel (без уведомлений и сводок). Через запятую
PANEL_IDS=
# 1 — любой, кто напишет боту /panel, сразу получает свою отдельную CRM (без подтверждения автора)
AUTO_WORKSPACES=
# Канал, подписку на который проверяем перед подарком. Для приватного канала оставь пустым:
# добавь бота админом канала — id подставится сам. Можно указать вручную: -100… или @username
CHANNEL=
# Ссылка для кнопки «Подписаться» (для приватного канала — инвайт-ссылка)
CHANNEL_URL=https://t.me/+vgRweLTf66k2Yzgy
# Лид-магнит: путь к файлу (PDF/ZIP) ИЛИ ссылка. Файл кладётся в assets/
LEAD_MAGNET_FILE=assets/lead_magnet.pdf
LEAD_MAGNET_URL=
# Тестовая версия приложения: ссылка на скачивание (RuStore, сайт, APK)
APP_URL=https://orsofeystore-orsofey.mia0.amvera.tech/app/ai-agent
# Подписка в Telegram Stars (30 дней, автопродление). Цена в звёздах
PRICE_STARS=250
SUBSCRIPTION_TITLE=Orsofey Assistant · подписка
# Необязательно: внешняя оплата картой (страница ЮKassa / сайт). Пусто — кнопки не будет
EXTERNAL_PAY_URL=
# Через сколько часов слать дожимающие сообщения
FOLLOWUP_TEST_H=24
FOLLOWUP_FEEDBACK_H=48
FOLLOWUP_FINAL_H=120
# DB_PATH — можно не указывать: на Amvera база сама ляжет в /data/bot.db, локально — в data/bot.db
DB_PATH=

# ---------- CRM ----------
# Адрес проекта бота на Amvera (Настройки проекта → Домены), без слэша в конце. Нужен для панели и учёта скачиваний
PUBLIC_URL=https://ИМЯ-ПРОЕКТА-orsofey.mia0.amvera.tech
# Порт панели (в amvera.yml стоит containerPort: 8080)
PORT=8080
# Через сколько часов без шага человек «застрял» и получает напоминание
DROP_HOURS=24
# Ежедневная сводка в Telegram: час и часовой пояс
REPORT_HOUR=9
TZ_NAME=Europe/Moscow
# Необязательно: пароль для входа в панель (без него — вход по коду из /panel)
PANEL_PASSWORD=
# Необязательно: ключ YouTube Data API (проще вставить в CRM → Настройки → Соцсети)
YT_API_KEY=
# Необязательно: HTTP-прокси для соцсетей, недоступных с хостинга (Instagram из России). Можно задать и в CRM → Настройки
SOCIAL_PROXY=
# Максимальный размер видео для «Публикации», МБ
MAX_UPLOAD_MB=4096
# Контакт для страниц /terms и /privacy (нужны TikTok/Instagram): почта или t.me/имя. Пусто — «через Telegram-бота»
LEGAL_CONTACT=
